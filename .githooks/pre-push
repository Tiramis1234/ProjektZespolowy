#!/usr/bin/env bash
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

root=$(git rev-parse --show-toplevel)
base=$(git rev-parse --verify -q origin/main || true)

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$remote_ref" == refs/heads/* ]] || continue
  [[ "$local_sha" =~ ^0+$ ]] && continue  # branch deletion

  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    echo "error: direct pushes to main are not allowed; open a pull request" >&2
    exit 1
  fi

  args=(--branch "${remote_ref#refs/heads/}")
  [[ -n "$base" ]] && args+=(--range "$base..$local_sha")
  bash "$root/scripts/check-conventions.sh" "${args[@]}"
done

if [[ -f "$root/scripts/test.sh" ]]; then
  bash "$root/scripts/test.sh"
fi
